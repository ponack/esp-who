# PP-OCRv6 example (ESP32-P4-Function-EV-Board, LVGL/graphic lib variant).
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Push partition table from default 0x8000 → 0x9000 so bootloader has a 28 KB
# (0x7000) window instead of 24 KB (0x6000). IDF v6.1's bootloader on ESP32-P4
# is ~0x6130 bytes; the default window is 304 bytes too small. All other
# esp-who examples ship the same offset — see partitions.csv (nvs moved 0xa000)
# and partitions2.csv accordingly.
CONFIG_PARTITION_TABLE_OFFSET=0x9000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
# Mirror .flash.rodata into PSRAM at boot so model weights read at PSRAM
# latency (~10 ns) instead of Flash cache. Halves det:model (~2.4 s vs
# ~5.5 s), at the cost of ~3–5 MB PSRAM. Combined with our vendored
# `param_copy=false` (see components/pp_ocr_v6/pp_ocr_v6.cpp), model
# params live in exactly one place — the PSRAM XIP mirror — instead of
# being duplicated into a second PSRAM heap copy.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_ESP_SYSTEM_ALLOW_RTC_FAST_MEM_AS_HEAP=n
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=4096
CONFIG_USB_HOST_HW_BUFFER_BIAS_IN=y
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_BSP_SD_FORMAT_ON_MOUNT_FAIL=y
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=2
CONFIG_BSP_DISPLAY_LVGL_AVOID_TEAR=y
CONFIG_CAMERA_SC2336=y
# Native square capture: pp_ocr_v6 detection input is 736×736.
CONFIG_CAMERA_SC2336_MIPI_RAW8_800X800_30FPS=y
CONFIG_CAMERA_SC2336_MIPI_DEFAULT_FMT_RAW8_800X800_30FPS=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
# The OCR core runs esp-dl SIMD kernels that hold CPU1 for hundreds of ms per
# op; skip its idle-task WDT and lift the global timeout.
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1 is not set
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
# Default rec-mode. DUAL fits with either FLASH_PARTITION+partitions2.csv or a
# CJK/LCD-buffer trim; see README.md.
CONFIG_FLASH_PP_OCR_V6_REC_S16=y
# CONFIG_FLASH_PP_OCR_V6_REC_S16_W640 is not set
CONFIG_PP_OCR_V6_REC_MODE_SHORT=y
# CONFIG_PP_OCR_V6_REC_MODE_DUAL is not set
# Pre-generated 24 pt / 2 bpp Noto Sans CJK SC subset for the overlay. Set to n
# to fall back to Montserrat (Latin only).
CONFIG_PP_OCR_V6_EXAMPLE_HAVE_CJK_FONT=y
# ~6.9 k CJK glyphs overflow LVGL's default 20-bit bitmap_index.
CONFIG_LV_FONT_FMT_TXT_LARGE=y
# Overlay uses per-label transform_scale; route LVGL allocs through the IDF
# heap so its built-in 64 KB TLSF pool doesn't fragment under redraw churn.
# CONFIG_LV_USE_BUILTIN_MALLOC is not set
CONFIG_LV_USE_CLIB_MALLOC=y

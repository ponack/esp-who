# Meshnology W11 ESP32-S3 CAM (OV3660), 16MB flash + 8MB octal PSRAM.
# Derived from sdkconfig.bsp.esp32_s3_eye_noglib; differences are the flash size,
# the camera sensor, and the dropped SD-card option (this board has no slot).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_OFFSET=0x9000
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# S3R8 die: 8MB octal PSRAM, verified at 80MHz with the memory test passing.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
# Enabled, matching Espressif's own S3 camera BSP configs. This was briefly
# turned off while chasing truncated DVP frames, on the theory that executing
# from PSRAM starved the camera DMA. That theory was wrong - the real causes
# were the VSYNC pin and sync polarity - and disabling it changed the error
# rate only marginally (~62k vs ~70k per 75s, both broken).
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_SPEED_80M=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP_SYSTEM_ALLOW_RTC_FAST_MEM_AS_HEAP=n

CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y

# Console is the native USB-Serial/JTAG, not a UART bridge.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# OV3660 at 240x240 RGB565 big-endian, matching the RGB565X format the esp-who
# DVP pipeline requests. The register sets assume a 20MHz XCLK.
CONFIG_CAMERA_OV3660=y
CONFIG_CAMERA_OV3660_DVP_RGB565_BE_240X240_24FPS=y
CONFIG_CAMERA_OV3660_DVP_DEFAULT_FMT_RGB565_BE_240X240_24FPS=y
CONFIG_CAMERA_OV2640=n
